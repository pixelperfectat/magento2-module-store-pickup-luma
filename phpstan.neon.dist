includes:
    # Shared level, bootstrap (bitexpert/phpstan-magento) and defaults.
    - vendor/pixelperfectat/coding-standard/phpstan.neon
    - phpstan-baseline.neon

parameters:
    phpVersion: 80300
    paths:
        - src
    excludePaths:
        - '*.sync-conflict-*'
    # Generated factories only exist in a generated Magento installation.
    scanFiles:
        - Test/Stubs/CountryFactory.php
